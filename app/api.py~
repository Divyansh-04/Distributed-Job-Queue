from fastapi import FastAPI
from pydantic import BaseModel

app = FastAPI(title = "Distributed Job Queue")

class JobSubmitRequest(BaseModel):
    task : str
    payload : dict = {}
    priority : str = "normal"



@app.get('./health')
async def health():
    return {"status" : "ok"}

@app.post('./jobs')
async def submit_job(job : JobSubmitRequest):
    return {"recieved": job.model_dump()}
